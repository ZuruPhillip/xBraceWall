<Window x:Class="CncWallStation.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:CncWallStation"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:vm="CncWallStationWPF.ViewModels"
    xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
    mc:Ignorable="d"

    Title="CNC工站管理系统" Height="791" Width="1280">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <!-- 侧边导航宽度 -->
            <ColumnDefinition Width="*"/>
            <!-- 内容区宽度 -->
        </Grid.ColumnDefinitions>

        <!-- 左侧：Logo + 侧边导航菜单 -->
        <Grid Grid.Column="0" Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ZURU Tech Logo -->
            <Border Grid.Row="0" Background="White">
                <svg:SvgViewbox
                        Source="/Resources/Images/ZURU_Tech_logo.svg"
                        Height="52"
                        Margin="12,15,12,12"/>
            </Border>

            <!-- HandyControl 侧边菜单 -->
            <hc:SideMenu Grid.Row="1"
                         Background="Transparent"
                         Margin="0,0,0,0">
            <hc:SideMenu.Items>
                <hc:SideMenuItem 
                Header="墙体清单" 
                Command="{Binding NavigateCommand}"
                CommandParameter="WallListPage"/>

                <hc:SideMenuItem 
                Header="BIM数据渲染" 
                Command="{Binding NavigateCommand}"
                CommandParameter="BimDataRenderPage"/>

                <hc:SideMenuItem 
                Header="MOM数据渲染" 
                Command="{Binding NavigateCommand}"
                CommandParameter="MomDataRenderPage"/>

                <!-- 控制页面 -->
                <hc:SideMenuItem 
                Header="JSON编辑器" 
                Command="{Binding NavigateCommand}"
                CommandParameter="JsonEditPage"/>

                <hc:SideMenuItem 
                Header="数据预检" 
                Command="{Binding NavigateCommand}"
                CommandParameter="DataCheckPage"/>

                <hc:SideMenuItem 
                Header="PLC指令单元" 
                Command="{Binding NavigateCommand}"
                CommandParameter="PlcDataPage"/>
                
                <!-- 控制页面 -->
                <hc:SideMenuItem 
                Header="控制页面" 
                Command="{Binding NavigateCommand}"
                CommandParameter="ControllerPage"/>

                <hc:SideMenuItem 
                Header="质量控制" 
                Command="{Binding NavigateCommand}"
                CommandParameter="QualityControlPage"/>
                
                <hc:SideMenuItem 
                Header="报表分析" 
                Command="{Binding NavigateCommand}"
                CommandParameter="ReportPage"/>

                <!-- 系统设置 -->
                <hc:SideMenuItem 
                Header="系统设置" 
                Command="{Binding NavigateCommand}"
                CommandParameter="SettingPage"/>
            </hc:SideMenu.Items>
        </hc:SideMenu>
        </Grid>

        <!-- 右侧：选项卡页面容器（MainPage），通过 code-behind 注入 -->
        <ContentControl x:Name="MainPageHost" Grid.Column="1" Grid.Row="0" Margin="10"/>

        <!-- 底部状态栏 -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid>
                <TextBlock Text="{Binding CurrentTime}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
