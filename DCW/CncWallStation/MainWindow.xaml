<Window x:Class="CncWallStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:CncWallStation"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:l="clr-namespace:CncWallStation.Localization"
    xmlns:vm="CncWallStationWPF.ViewModels"
    xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
    mc:Ignorable="d"

    Title="{l:Loc AppTitle}" Height="791" Width="1280">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <!-- 侧边导航宽度 -->
            <ColumnDefinition Width="*"/>
            <!-- 内容区宽度 -->
        </Grid.ColumnDefinitions>

        <!-- 左侧：Logo + 侧边导航菜单 -->
        <Grid Grid.Column="0" Grid.Row="0" Background="{DynamicResource SecondaryRegionBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ZURU Tech Logo -->
            <Border Grid.Row="0" Background="White">
                <svg:SvgViewbox
                        Source="/Resources/Images/ZURU_Tech_logo.svg"
                        Height="52"
                        Margin="12,15,12,12"/>
            </Border>

            <!-- HandyControl 侧边菜单 -->
            <hc:SideMenu Grid.Row="1"
                         Background="Transparent"
                         Margin="0,0,0,0">
            <hc:SideMenu.Items>
                <hc:SideMenuItem 
                Header="{l:Loc Menu_WallList}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="WallListPage"/>

                <hc:SideMenuItem 
                Header="{l:Loc Menu_BimRender}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="BimDataRenderPage"/>

                <hc:SideMenuItem 
                Header="{l:Loc Menu_MomRender}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="MomDataRenderPage"/>

                <!-- JSON编辑器 -->
                <hc:SideMenuItem 
                Header="{l:Loc Menu_JsonEditor}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="JsonEditPage"/>

                <hc:SideMenuItem 
                Header="{l:Loc Menu_DataCheck}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="DataCheckPage"/>

                <hc:SideMenuItem 
                Header="{l:Loc Menu_PlcData}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="PlcDataPage"/>
                
                <!-- 控制页面 -->
                <hc:SideMenuItem 
                Header="{l:Loc Menu_Controller}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="ControllerPage"/>

                <hc:SideMenuItem 
                Header="{l:Loc Menu_ExceptionReport}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="ExceptionReportPage"/>
                    
                
                <hc:SideMenuItem 
                Header="{l:Loc Menu_Quality}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="QualityControlPage"/>
                
                <hc:SideMenuItem 
                Header="{l:Loc Menu_Report}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="ReportPage"/>

                <!-- 系统设置 -->
                <hc:SideMenuItem 
                Header="{l:Loc Menu_Settings}" 
                Command="{Binding NavigateCommand}"
                CommandParameter="SettingPage"/>
            </hc:SideMenu.Items>
        </hc:SideMenu>
        </Grid>

        <!-- 右侧：选项卡页面容器（MainPage），通过 code-behind 注入 -->
        <ContentControl x:Name="MainPageHost" Grid.Column="1" Grid.Row="0" Margin="10"/>

        <!-- 底部状态栏 -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Background="{DynamicResource SecondaryRegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- OPC 连接状态指示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#9E9E9E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OpcStatusColor}" Value="#4CAF50">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OpcStatusColor}" Value="#FF9800">
                                        <Setter Property="Fill" Value="#FF9800"/>
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OpcStatusColor}" Value="#F44336">
                                        <Setter Property="Fill" Value="#F44336"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding OpcStatusColor}" Value="#9E9E9E">
                                        <Setter Property="Fill" Value="#9E9E9E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding OpcStatusText}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>

                <!-- 当前时间 -->
                <TextBlock Grid.Column="2" Text="{Binding CurrentTime}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
