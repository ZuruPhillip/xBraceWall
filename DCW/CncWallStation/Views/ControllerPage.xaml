<Page x:Class="CncWallStation.Views.ControllerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CncWallStation.Views"
      xmlns:l="clr-namespace:CncWallStation.Localization"
      xmlns:opc="clr-namespace:CncWallStation.Services.OpcUa"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="{l:Loc PageTitle_Controller}">

    <Page.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#475569"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Status color converter -->
        <local:OpcQualityColorConverter x:Key="QualityColorConverter"/>
    </Page.Resources>

    <Grid Margin="8" Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== Row0: 标题栏 ==================== -->
        <Border Grid.Row="0" Padding="10" Margin="0,0,0,6"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="20" Background="#1890FF" CornerRadius="2" Margin="0,0,10,0" />
                <TextBlock Text="{l:Loc PageTitle_Controller}" FontSize="18" FontWeight="Bold"
                           Foreground="#333" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ==================== Row2: OPC 节点监控区域 ==================== -->
        <Border Grid.Row="2" Background="White" CornerRadius="4"
                BorderBrush="#E8E8E8" BorderThickness="1"
                Padding="16" Margin="10,0,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 监控标题 + 操作按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{l:Loc Controller_OpcMonitor}" FontSize="15"
                                   FontWeight="Bold" Foreground="#333"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Loc Controller_OpcMonitorDesc}"
                                   FontSize="12" Foreground="#999"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:Loc Controller_LoadNodes}"
                                Style="{StaticResource SmallButtonStyle}"
                                Command="{Binding LoadOpcNodesCommand}"/>
                        <Button Content="{l:Loc Controller_RefreshValues}"
                                Style="{StaticResource SmallButtonStyle}"
                                Command="{Binding RefreshOpcValuesCommand}"/>
                        <Button Content="{l:Loc Controller_SubscribeAll}"
                                Style="{StaticResource SmallButtonStyle}"
                                Command="{Binding SubscribeAllNodesCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- 节点监控 DataGrid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding OpcMonitoredNodes}"
                          SelectedItem="{Binding SelectedOpcMonitoredNode}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          MinHeight="200"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderBrush="#E2E8F0"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Loc Controller_GridNodeId}"
                                            Binding="{Binding NodeId}"
                                            Width="220"/>
                        <DataGridTextColumn Header="{l:Loc Controller_GridDescription}"
                                            Binding="{Binding Description}"
                                            Width="140"/>
                        <DataGridTextColumn Header="{l:Loc Controller_GridValue}"
                                            Binding="{Binding CurrentValue}"
                                            Width="160"/>
                        <DataGridTextColumn Header="{l:Loc Controller_GridQuality}"
                                            Binding="{Binding Quality}"
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#333"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Quality}" Value="Good">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Quality}" Value="Bad">
                                            <Setter Property="Foreground" Value="#F44336"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Quality}" Value="Uncertain">
                                            <Setter Property="Foreground" Value="#FF9800"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Header="{l:Loc Controller_GridWritable}"
                                                Binding="{Binding IsWritable}"
                                                Width="60"/>
                        <DataGridTextColumn Header="{l:Loc Controller_GridUpdated}"
                                            Binding="{Binding LastUpdated, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                            Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
