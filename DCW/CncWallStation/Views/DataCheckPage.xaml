<Page x:Class="CncWallStation.Views.DataCheckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:l="clr-namespace:CncWallStation.Localization"
      xmlns:local="clr-namespace:CncWallStation.Views"
      xmlns:enums="clr-namespace:CncWallStation.Models.Enums"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="1400"
      Title="{l:Loc PageTitle_DataCheck}"
      FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Page.Resources>
        <!-- 严重等级颜色转换器 -->
        <local:SeverityToColorConverter x:Key="SeverityToColorConverter"/>
        <local:SeverityToIconConverter x:Key="SeverityToIconConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <local:BoolInvertConverter x:Key="BoolInvertConverter"/>
        <local:ScoreToColorConverter x:Key="ScoreToColorConverter"/>
        <local:IsPassedToColorConverter x:Key="IsPassedToColorConverter"/>
    </Page.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ━━━━━ 顶部搜索栏 ━━━━━ -->
        <Border Grid.Row="0" Margin="8,8,8,6" Padding="20,15" Background="White"
                CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="20" Background="#1890FF" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="{l:Loc PageTitle_DataCheck}" FontSize="18" FontWeight="Bold" Foreground="#333"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 搜索控件 + 执行预检 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc Common_WallId}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#666"/>
                    <TextBox x:Name="TxtWallId" Text="{Binding SearchWallId, UpdateSourceTrigger=PropertyChanged}"
                             Width="300" Height="34" VerticalContentAlignment="Center"
                             Style="{StaticResource TextBoxExtend}"
                             hc:InfoElement.Placeholder="{l:Loc Label_Placeholder_WallId}"/>
                    <Button Content="{l:Loc Common_Search}" Command="{Binding SearchCommand}" Width="110" Height="34"
                            Margin="12,0,0,0" Style="{StaticResource ButtonPrimary}"/>
                    <Button Content="{l:Loc Button_StartCheck}" Command="{Binding StartCheckCommand}"
                            Width="130" Height="34" Style="{StaticResource ButtonPrimary}"
                            Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--  墙体详情行（搜索到才显示） -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#E6F4FF"
                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{Binding HasWallInfo, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Common_WallId}" Style="{StaticResource DetailLabelText}" Width="60"/>
                <TextBlock Text="{Binding DetailWallId}" Style="{StaticResource DetailValueText}" Width="250"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_Project}" Style="{StaticResource DetailLabelText}" Width="30"/>
                <TextBlock Text="{Binding DetailProject}" Style="{StaticResource DetailValueText}" Width="50"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_Floor}" Style="{StaticResource DetailLabelText}" Width="30"/>
                <TextBlock Text="{Binding DetailFloor}" Style="{StaticResource DetailValueText}" Width="50"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_Stage}" Style="{StaticResource DetailLabelText}" Width="30"/>
                <TextBlock Text="{Binding DetailStage}" Style="{StaticResource DetailValueText}" Width="50"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_Version}" Style="{StaticResource DetailLabelText}" Width="30"/>
                <TextBlock Text="{Binding DetailVersion}" Style="{StaticResource DetailValueText}" Width="50"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_ImportTime}" Style="{StaticResource DetailLabelText}" Width="60"/>
                <TextBlock Text="{Binding DetailImportTime}" Style="{StaticResource DetailValueText}"/>

            </StackPanel>
        </Border>

        <!-- ━━━━━ 主内容区 ━━━━━ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左：TabControl -->
            <TabControl x:Name="MainTabControl" Margin="15,10" Background="White"
                        Style="{StaticResource TabControlCapsule}">
                <!-- Tab 1: 预检结果 -->
                <TabItem Header="{l:Loc Tab_CheckResults}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                        <StackPanel Margin="15">
                            <!-- 评分卡片 + 严重等级分布（同行） -->
                            <Grid Margin="0,10,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- BIM模型总分卡片 -->
                                <Border Grid.Column="0" Width="180" Height="90" CornerRadius="8" Background="White"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.12" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{l:Loc Score_BimTotal}" Foreground="#999" FontSize="12"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding BimTotalScore, StringFormat={}{0:F0}}"
                                                   FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{Binding BimTotalScore, Converter={StaticResource ScoreToColorConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- MOM模型总分卡片 -->
                                <Border Grid.Column="1" Width="180" Height="90" CornerRadius="8" Background="White"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.12" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{l:Loc Score_MomTotal}" Foreground="#999" FontSize="12"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding MomTotalScore, StringFormat={}{0:F0}}"
                                                   FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{Binding MomTotalScore, Converter={StaticResource ScoreToColorConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- 严重等级分布（同行右侧，紧凑布局） -->
                                <Border Grid.Column="2" CornerRadius="8" Background="White"
                                        BorderBrush="#E0E0E0" BorderThickness="1" Padding="20,10">
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Section_SeverityDistribution}" FontSize="13" FontWeight="Bold"
                                                   Foreground="#333" Margin="0,0,0,8"/>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{l:Loc Severity_Critical}" Foreground="#FF4D4F" FontWeight="SemiBold" FontSize="12"/>
                                            <ProgressBar Grid.Column="1" Height="14" Minimum="0" Maximum="100"
                                                         Value="{Binding CriticalCount}" Foreground="#FF4D4F" Margin="6,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CriticalCount}" Foreground="#FF4D4F"
                                                       FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{l:Loc Severity_Error}" Foreground="#FF7A45" FontWeight="SemiBold" FontSize="12"/>
                                            <ProgressBar Grid.Column="1" Height="14" Minimum="0" Maximum="100"
                                                         Value="{Binding ErrorCount}" Foreground="#FF7A45" Margin="6,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ErrorCount}" Foreground="#FF7A45"
                                                       FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{l:Loc Severity_Warning}" Foreground="#FAAD14" FontWeight="SemiBold" FontSize="12"/>
                                            <ProgressBar Grid.Column="1" Height="14" Minimum="0" Maximum="100"
                                                         Value="{Binding WarningCount}" Foreground="#FAAD14" Margin="6,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding WarningCount}" Foreground="#FAAD14"
                                                       FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{l:Loc Severity_Info}" Foreground="#1677FF" FontWeight="SemiBold" FontSize="12"/>
                                            <ProgressBar Grid.Column="1" Height="14" Minimum="0" Maximum="100"
                                                         Value="{Binding InfoCount}" Foreground="#1677FF" Margin="6,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding InfoCount}" Foreground="#1677FF"
                                                       FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 特征分类统计 -->
                            <GroupBox Header="{l:Loc GroupBox_BimFeatureStats}" Padding="10" Margin="0,0,0,10">
                                <DataGrid ItemsSource="{Binding BimFeatureResults}"
                                          AutoGenerateColumns="False" HeadersVisibility="Column"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True" RowHeight="32">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:Loc Column_FeatureName}" Binding="{Binding CategoryNameCn}" Width="120"/>
                                        <DataGridTextColumn Header="{l:Loc Column_CheckItems}" Binding="{Binding CheckItemCount}" Width="70"/>
                                        <DataGridTextColumn Header="{l:Loc Severity_Critical}" Binding="{Binding CriticalCount}" Width="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF4D4F"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{l:Loc Severity_Error}" Binding="{Binding ErrorCount}" Width="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FF7A45"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{l:Loc Severity_Warning}" Binding="{Binding WarningCount}" Width="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FAAD14"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{l:Loc Severity_Info}" Binding="{Binding InfoCount}" Width="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1677FF"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{l:Loc Column_Score}" Binding="{Binding Score, StringFormat={}{0:F0}}" Width="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{Binding Score, Converter={StaticResource ScoreToColorConverter}}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="{l:Loc Column_Status}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding IsPassed, Converter={StaticResource IsPassedToColorConverter}}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <!-- 特征分类统计 - MomData -->
                            <GroupBox Header="{l:Loc GroupBox_MomFeatureStats}" Padding="10" Margin="0,0,0,10">
                                <DataGrid ItemsSource="{Binding MomFeatureResults}"
                                          AutoGenerateColumns="False" HeadersVisibility="Column"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True" RowHeight="32">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:Loc Column_FeatureName}" Binding="{Binding CategoryNameCn}" Width="120"/>
                                        <DataGridTextColumn Header="{l:Loc Column_CheckItems}" Binding="{Binding CheckItemCount}" Width="70"/>
                                        <DataGridTextColumn Header="{l:Loc Severity_Critical}" Binding="{Binding CriticalCount}" Width="60"/>
                                        <DataGridTextColumn Header="{l:Loc Severity_Error}" Binding="{Binding ErrorCount}" Width="60"/>
                                        <DataGridTextColumn Header="{l:Loc Severity_Warning}" Binding="{Binding WarningCount}" Width="60"/>
                                        <DataGridTextColumn Header="{l:Loc Severity_Info}" Binding="{Binding InfoCount}" Width="60"/>
                                        <DataGridTextColumn Header="{l:Loc Column_Score}" Binding="{Binding Score, StringFormat={}{0:F0}}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: 异常清单（已隐藏） -->
                <TabItem Header="{l:Loc Tab_ErrorList}" Visibility="Collapsed">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 严重等级筛选 -->
                        <WrapPanel Margin="0,10">
                            <Button Content="{l:Loc Filter_All}" Width="100" Height="30" Margin="0,0,8,5"
                                    Command="{Binding SetSeverityFilterCommand}" CommandParameter=""
                                    Style="{StaticResource ButtonDefault}"/>
                            <Button Content="{l:Loc Severity_Critical}" Width="100" Height="30" Margin="0,0,8,5"
                                    Command="{Binding SetSeverityFilterCommand}" CommandParameter="Critical"
                                    Foreground="#FF4D4F" Style="{StaticResource ButtonDefault}"/>
                            <Button Content="{l:Loc Severity_Error}" Width="100" Height="30" Margin="0,0,8,5"
                                    Command="{Binding SetSeverityFilterCommand}" CommandParameter="Error"
                                    Foreground="#FF7A45" Style="{StaticResource ButtonDefault}"/>
                            <Button Content="{l:Loc Severity_Warning}" Width="100" Height="30" Margin="0,0,8,5"
                                    Command="{Binding SetSeverityFilterCommand}" CommandParameter="Warning"
                                    Foreground="#FAAD14" Style="{StaticResource ButtonDefault}"/>
                            <Button Content="{l:Loc Severity_Info}" Width="100" Height="30" Margin="0,0,8,5"
                                    Command="{Binding SetSeverityFilterCommand}" CommandParameter="Info"
                                    Foreground="#1677FF" Style="{StaticResource ButtonDefault}"/>
                        </WrapPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredErrors}"
                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" RowHeight="32"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{l:Loc Column_Level}" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="6,2"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityToColorConverter}}">
                                                <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToIconConverter}}"
                                                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:Loc Column_Classification}" Binding="{Binding ErrorCategory}" Width="80"/>
                                <DataGridTextColumn Header="{l:Loc Column_FeatureCategory}" Binding="{Binding FeatureCategory}" Width="130"/>
                                <DataGridTextColumn Header="{l:Loc Column_ErrorCode}" Binding="{Binding ErrorCode}" Width="150"/>
                                <DataGridTextColumn Header="{l:Loc Column_DescriptionCn}" Binding="{Binding ErrorMessage}" Width="300"/>
                                <DataGridTextColumn Header="{l:Loc Column_DescriptionEn}" Binding="{Binding ErrorMessageEn}" Width="300"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 3: 历史记录（已隐藏） -->
                <TabItem Header="{l:Loc Tab_History}" Visibility="Collapsed">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Button Content="{l:Loc Button_LoadHistory}" Command="{Binding LoadHistoryCommand}"
                                Width="150" Height="32" Margin="0,10" Style="{StaticResource ButtonDefault}"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding HistoryRecords}"
                                  SelectedItem="{Binding SelectedHistory1}"
                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" RowHeight="32" Height="200"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:Loc Column_CheckTime}" Binding="{Binding CheckTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="160"/>
                                <DataGridTextColumn Header="{l:Loc Common_Version}" Binding="{Binding Version}" Width="80"/>
                                <DataGridTextColumn Header="{l:Loc Column_BimScore}" Binding="{Binding BimScore, StringFormat={}{0:F0}}" Width="80"/>
                                <DataGridTextColumn Header="{l:Loc Column_MomScore}" Binding="{Binding MomScore, StringFormat={}{0:F0}}" Width="80"/>
                                <DataGridTextColumn Header="{l:Loc Column_ErrorCount}" Binding="{Binding ErrorCount}" Width="70"/>
                                <DataGridTextColumn Header="{l:Loc Column_Result}" Binding="{Binding ResultText}" Width="80"/>
                                <DataGridTextColumn Header="{l:Loc Column_Operator}" Binding="{Binding Operator}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 差异对比区域 -->
                        <GroupBox Grid.Row="2" Header="{l:Loc GroupBox_DiffCompare}" Padding="10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                                    <TextBlock Text="{l:Loc Label_SelectTwoRecords}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox ItemsSource="{Binding HistoryRecords}"
                                              SelectedItem="{Binding SelectedHistory1}"
                                              DisplayMemberPath="CheckTime" Width="200" Height="30"
                                              Margin="0,0,10,0"/>
                                    <TextBlock Text="{l:Loc Label_Vs}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               FontWeight="Bold"/>
                                    <ComboBox ItemsSource="{Binding HistoryRecords}"
                                              SelectedItem="{Binding SelectedHistory2}"
                                              DisplayMemberPath="CheckTime" Width="200" Height="30"
                                              Margin="0,0,10,0"/>
                                    <Button Content="{l:Loc Button_Compare}" Command="{Binding CompareDiffCommand}"
                                            Width="100" Height="30" Style="{StaticResource ButtonPrimary}"/>
                                </StackPanel>

                                <Grid Grid.Row="1" Visibility="{Binding HasDiffResult, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 新增异常 -->
                                    <GroupBox Grid.Column="0" Header="{l:Loc GroupBox_NewErrors}" Margin="0,0,5,0">
                                        <ListBox ItemsSource="{Binding DiffResult.NewErrors}" BorderThickness="0"
                                                 Background="#FFF1F0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </GroupBox>

                                    <!-- 已修复异常 -->
                                    <GroupBox Grid.Column="1" Header="{l:Loc GroupBox_FixedErrors}" Margin="5,0">
                                        <ListBox ItemsSource="{Binding DiffResult.FixedErrors}" BorderThickness="0"
                                                 Background="#F6FFED">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </GroupBox>

                                    <!-- 仍存在异常 -->
                                    <GroupBox Grid.Column="2" Header="{l:Loc GroupBox_PersistentErrors}" Margin="5,0,0,0">
                                        <ListBox ItemsSource="{Binding DiffResult.PersistentErrors}" BorderThickness="0"
                                                 Background="#FFFBE6">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- 右：批量预检面板（已隐藏） -->
            <Border Grid.Column="1" Width="320" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="{l:Loc Section_BatchCheck}" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                        <TextBlock Text="{l:Loc Label_ProjectNumber}" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BatchFilterProjectNumber}" Height="30" Margin="0,0,0,10"
                                 hc:InfoElement.Placeholder="{l:Loc Placeholder_LeaveEmpty}"/>

                        <TextBlock Text="{l:Loc Label_BatchFloor}" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BatchFilterFloor}" Height="30" Margin="0,0,0,10"
                                 hc:InfoElement.Placeholder="{l:Loc Placeholder_LeaveEmpty}"/>

                        <TextBlock Text="{l:Loc Label_BatchVersion}" FontSize="12" Foreground="#666" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding BatchFilterVersionOptions}"
                                  SelectedItem="{Binding BatchFilterSelectedVersion}"
                                  Height="30" Margin="0,0,0,10"/>

                        <Button Content="{l:Loc Button_StartBatchCheck}" Command="{Binding StartBatchCheckCommand}"
                                Width="180" Height="36" Style="{StaticResource ButtonPrimary}"
                                IsEnabled="{Binding IsChecking, Converter={StaticResource BoolInvertConverter}}"/>

                        <!-- 进度条 -->
                        <Grid Margin="0,15,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ProgressBar Height="20" Minimum="0" Maximum="100"
                                         Value="{Binding BatchProgress}"/>
                            <TextBlock Grid.Row="1" Text="{Binding BatchStatusText}"
                                       FontSize="12" Foreground="#666" Margin="0,5,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- 问题墙体 Top 榜 -->
                        <TextBlock Text="{l:Loc Section_TopProblemWalls}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#333" Margin="0,20,0,8"/>
                        <ItemsControl ItemsSource="{Binding TopProblemWalls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,0,0,4" CornerRadius="4"
                                            Background="#FFF7F7" BorderBrush="#FFE0E0" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding WallKey}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock FontSize="11" Foreground="#666">
                                                <Run Text="Bim:"/><Run Text="{Binding BimTotalScore, StringFormat={}{0:F0}}" Foreground="#FF4D4F"/>
                                                <Run Text=" Mom:"/><Run Text="{Binding MomTotalScore, StringFormat={}{0:F0}}" Foreground="#FF7A45"/>
                                                <Run Text=" Critical:"/><Run Text="{Binding CriticalCount}" Foreground="#FF4D4F"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{l:Loc Button_ExportBatchReport}" Command="{Binding ExportBatchExcelCommand}"
                                Width="180" Height="32" Style="{StaticResource ButtonDefault}" Margin="0,15,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ━━━━━ 底部状态栏 ━━━━━ -->
        <Border Grid.Row="3" Background="White" Padding="20,8" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                    <Button Content="{l:Loc Button_ExportPdf}" Command="{Binding ExportPdfCommand}"
                            Width="150" Height="30" Margin="0,0,8,0" Style="{StaticResource ButtonDefault}"/>
                    <Button Content="{l:Loc Button_ExportExcel}" Command="{Binding ExportExcelCommand}"
                            Width="150" Height="30" Style="{StaticResource ButtonDefault}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CheckStatusText}" Foreground="#666" FontSize="12"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " Foreground="#CCC" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="{Binding GroupInfoText}" Foreground="#999" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
