<Page x:Class="CncWallStation.Views.ExceptionReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:l="clr-namespace:CncWallStation.Localization"
      xmlns:conv="clr-namespace:CncWallStation.Converters"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="异常报告"
      FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="#F5F5F5" Loaded="Page_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ Row0: 顶部状态栏 ═══════════════ -->
        <Border Grid.Row="0" Margin="8,8,8,6" Padding="16,12"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 蓝色竖条 + 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="4" Height="24" Background="#1890FF"
                            CornerRadius="2" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="异常报告" FontSize="16" FontWeight="Bold"
                               Foreground="#262626" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PageSubtitle, FallbackValue=历史异常记录}"
                               Foreground="#8C8C8C" FontSize="12" VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════ Row1: 主内容区 ═══════════════ -->
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 历史异常列表 -->
            <Border Grid.Row="0" Background="White" CornerRadius="4"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 列表标题 -->
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="3" Height="14" Background="#1890FF"
                                    CornerRadius="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="历史异常记录" Foreground="#262626" FontSize="13"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Foreground="#8C8C8C" FontSize="11" VerticalAlignment="Center"
                                       Margin="8,0,0,0">
                                <Run Text="共 "/><Run Text="{Binding TotalCount, Mode=OneWay, FallbackValue=0}"/><Run Text=" 条"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ExceptionReports}"
                              SelectedItem="{Binding SelectedReport}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource LightDataGridStyle}"
                              BorderThickness="0,1,0,0"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Width="60"
                                                Binding="{Binding RowIndex}"/>
                            <DataGridTextColumn Header="墙体Id" Width="120"
                                                Binding="{Binding WallIdStr}"/>
                            <DataGridTextColumn Header="异常类型" Width="120"
                                                Binding="{Binding ExceptionTypeDisplay}"/>
                            <DataGridTextColumn Header="描述" Width="200"
                                                Binding="{Binding Description}"/>
                            <DataGridTextColumn Header="时间" Width="150"
                                                Binding="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                            <DataGridTextColumn Header="操作人" Width="80"
                                                Binding="{Binding Operator}"/>
                            <DataGridTemplateColumn Header="状态" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="2"
                                                Padding="6,2"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                            <Setter Property="Background" Value="#F6FFED"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                            <Setter Property="Background" Value="#FFF7E6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                                <Setter Property="Text" Value="已解决"/>
                                                                <Setter Property="Foreground" Value="#52C41A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsResolved}" Value="False">
                                                                <Setter Property="Text" Value="未解决"/>
                                                                <Setter Property="Foreground" Value="#FA8C16"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="查看"
                                                    Height="24" FontSize="10" MinWidth="50"
                                                    Padding="4,0" Margin="0,0,3,0"
                                                    Command="{Binding DataContext.ViewReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BaseButtonStyle}"/>
                                            <Button Content="编辑"
                                                    Height="24" FontSize="10" MinWidth="50"
                                                    Padding="4,0" Margin="0,0,3,0"
                                                    Command="{Binding DataContext.EditReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Visibility="{Binding IsResolved, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                            <Button Content="解决"
                                                    Height="24" FontSize="10" MinWidth="50"
                                                    Padding="4,0"
                                                    Command="{Binding DataContext.ResolveReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BaseButtonStyle}"
                                                    Visibility="{Binding IsResolved, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 分页控件 -->
            <Border Grid.Row="1" Background="White" CornerRadius="4"
                    BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,6,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Foreground="#8C8C8C" FontSize="12"
                               VerticalAlignment="Center">
                        <Run Text="第 "/><Run Text="{Binding DisplayPageIndex, Mode=OneWay, FallbackValue=1}"/><Run Text=" 页，共 "/><Run Text="{Binding TotalPages, Mode=OneWay, FallbackValue=1}"/><Run Text=" 页"/>
                    </TextBlock>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="上一页" Width="80" Height="28"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanPreviousPage}"
                                Style="{StaticResource BaseButtonStyle}"
                                FontSize="11"/>
                        <Button Content="下一页" Width="80" Height="28" Margin="8,0,0,0"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanNextPage}"
                                Style="{StaticResource BaseButtonStyle}"
                                FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
