<Page x:Class="CncWallStation.Views.JsonEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CncWallStation.Views"
      xmlns:vm="clr-namespace:CncWallStation.ViewModels"
      xmlns:models="clr-namespace:CncWallStation.Models"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="1200"
      Background="{StaticResource BgWhite}"
      Title="JSON编辑器">

    <Page.Resources>
        <!-- Bool 转 Visibility 转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- 节点类型图标转换器 -->
        <Style x:Key="TreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- 树节点模板 -->
        <HierarchicalDataTemplate DataType="{x:Type models:JsonTreeNode}"
                                   ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                <Setter Property="Background" Value="#FFEB3B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 类型图标 -->
                <TextBlock Grid.Column="0" Margin="0,0,4,0" FontFamily="Consolas" FontSize="12"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeType}" Value="Object">
                                    <Setter Property="Text" Value="{}{ }" />
                                    <Setter Property="Foreground" Value="#E91E63" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeType}" Value="Array">
                                    <Setter Property="Text" Value="[ ]" />
                                    <Setter Property="Foreground" Value="#9C27B0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeType}" Value="Property">
                                    <Setter Property="Text" Value="◇" />
                                    <Setter Property="Foreground" Value="#2196F3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NodeType}" Value="Value">
                                    <Setter Property="Text" Value="▪" />
                                    <Setter Property="Foreground" Value="#4CAF50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Key 名（中文翻译）- 非编辑模式显示 -->
                <TextBlock Grid.Column="1" Text="{Binding DisplayKey}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="2,1,6,1" Padding="2,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 值预览 / 子项描述 - 非编辑模式显示 -->
                <TextBlock Grid.Column="2" Margin="8,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           MaxWidth="350" FontStyle="Italic" FontFamily="Consolas">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            <Setter Property="Text" Value="{Binding ValuePreview}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValueNode}" Value="False">
                                    <Setter Property="Text"
                                            Value="{Binding ChildCountDescription}" />
                                    <Setter Property="FontStyle" Value="Normal" />
                                    <Setter Property="Foreground" Value="#999999" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 编辑输入框（编辑模式下显示，Enter确认/Esc取消） -->
                <TextBox Grid.Column="1" Grid.ColumnSpan="2"
                         Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="12" Height="22" VerticalAlignment="Center"
                         Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                         Loaded="EditTextBox_Loaded"
                         KeyDown="EditTextBox_KeyDown" />
            </Grid>
        </HierarchicalDataTemplate>

        <!-- 加载遮罩 -->
        <SolidColorBrush x:Key="LoadingOverlayBrush" Color="#80000000" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 工具栏 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BgLightGray}"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：墙体信息 + 操作按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="墙体 ID:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource BodyText}" />
                    <TextBox Text="{Binding WallId, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Height="30" VerticalAlignment="Center"
                             Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,10,0"
                             x:Name="WallIdTextBox" />
                    <Button Content="加载" Command="{Binding LoadCommand}" Width="60" Height="30"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                               Margin="4,2" />
                    <Button Content="保存" Command="{Binding SaveCommand}" Width="60" Height="30"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
                    <Button Content="格式化" Command="{Binding FormatJsonCommand}" Width="60" Height="30"
                            Style="{StaticResource BaseButtonStyle}" Margin="0,0,6,0" />
                    <Button Content="刷新树" Command="{Binding RefreshTreeCommand}" Width="60" Height="30"
                            Style="{StaticResource BaseButtonStyle}" />
                </StackPanel>

                <!-- 中间：搜索框 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Height="30" VerticalAlignment="Center"
                             Style="{StaticResource BaseTextBoxStyle}"
                             x:Name="SearchTextBox">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="搜索" Command="{Binding SearchCommand}" Width="50" Height="30"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,4,0" />
                    <Button Content="清除" Command="{Binding ClearSearchCommand}" Width="50" Height="30"
                            Style="{StaticResource BaseButtonStyle}" />

                    <!-- 匹配计数 -->
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                               x:Name="MatchCountText">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text"
                                        Value="{Binding MatchCount, StringFormat='匹配 {0} 项'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MatchCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 右侧：加载指示器 -->
                <TextBlock Grid.Column="2" Text="● 加载中..." Foreground="#1677FF"
                           VerticalAlignment="Center" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ==================== 主内容区（左右分栏） ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：JSON 树视图 -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 树视图标题 -->
                    <Border Grid.Row="0" Background="{StaticResource BgLightGray}"
                            Padding="12,6" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="JSON 树视图（右键节点操作）" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" FontSize="13" />
                    </Border>

                    <!-- 树视图 -->
                    <TreeView Grid.Row="1" x:Name="JsonTreeView"
                              ItemsSource="{Binding TreeNodes}"
                              ItemContainerStyle="{StaticResource TreeViewItemStyle}"
                              SelectedItemChanged="JsonTreeView_SelectedItemChanged"
                              MouseDoubleClick="JsonTreeView_MouseDoubleClick"
                              PreviewMouseRightButtonDown="JsonTreeView_PreviewMouseRightButtonDown"
                              Background="{StaticResource BgWhite}"
                              BorderThickness="0" Margin="4,2">

                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="TreeContextMenu"
                                         DataContext="{Binding PlacementTarget.DataContext,
                                             RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="编辑值" Click="MenuItem_EditValue_Click" />
                                <Separator />
                                <MenuItem Header="删除节点" Command="{Binding DeleteNodeCommand}"
                                          Foreground="#FF1744" />
                                <Separator />
                                <MenuItem Header="全部展开" Click="MenuItem_ExpandAll_Click" />
                                <MenuItem Header="全部折叠" Click="MenuItem_CollapseAll_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 分隔条 -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderLight}" />

            <!-- 右侧：原始 JSON 文本编辑器 -->
            <Border Grid.Column="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 文本编辑器标题 -->
                    <Border Grid.Row="0" Background="{StaticResource BgLightGray}"
                            Padding="12,6" BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="原始 JSON（可编辑）" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" FontSize="13" />
                            <TextBlock Text="● 已修改" Margin="16,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="#FF1744">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasChanges}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- JSON 文本编辑区 -->
                    <TextBox Grid.Row="1" x:Name="JsonTextBox"
                             Text="{Binding FormattedJsonText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13"
                             BorderThickness="1" Margin="6,4"
                             BorderBrush="{StaticResource BorderLight}"
                             TextWrapping="NoWrap"
                             Background="{StaticResource BgWhite}"
                             Foreground="{StaticResource TextPrimary}"
                             Padding="8"
                             LostFocus="JsonTextBox_LostFocus" />

                    <!-- 错误信息栏 -->
                    <Border Grid.Row="2" Padding="12,8"
                            Background="#FFF3F0" BorderBrush="#FFCDD2" BorderThickness="0,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="JSON 格式错误：" Foreground="#D32F2F"
                                           FontWeight="SemiBold" FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="4,0,0,0" />
                            </StackPanel>
                            <TextBlock Margin="4,4,0,0" FontSize="11" Foreground="#999999">
                                <Run Text="位置：行 " />
                                <Run Text="{Binding ErrorLine}" />
                                <Run Text=", 列 " />
                                <Run Text="{Binding ErrorColumn}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 底部状态栏 ==================== -->
        <Border Grid.Row="2" Background="{StaticResource BgLightGray}"
                BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BorderGray}" />
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <TextBlock Grid.Column="1" FontSize="11"
                           Foreground="{StaticResource TextPlaceholder}"
                           VerticalAlignment="Center"
                           Text="保存时 PipelineStage → 待校验" />
            </Grid>
        </Border>
    </Grid>
</Page>
