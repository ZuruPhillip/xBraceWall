<Window x:Class="CncWallStation.Views.MarkExceptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CncWallStation.Converters"
        Title="{Binding Title, FallbackValue=标记异常}"
        Width="600" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ 表单内容 ═══════════════ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="16,16,16,8">
            <StackPanel>

                <!-- 墙体搜索 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="墙体搜索" Foreground="#262626" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center" Width="80"/>
                        </StackPanel>

                        <!-- 搜索框 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBoxStyle}"
                                     VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchWallsCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1" Content="搜索" Width="60" Height="32" Margin="8,0,0,0"
                                    Command="{Binding SearchWallsCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" FontSize="12"/>
                        </Grid>

                        <!-- 搜索结果列表 -->
                        <Border Grid.Row="2" Margin="0,8,0,0" MaxHeight="180"
                                Background="#FAFAFA" CornerRadius="4"
                                BorderBrush="#F0F0F0" BorderThickness="1"
                                Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedWall}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding WallId}"
                                                       Foreground="#262626" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProjectName}"
                                                       Foreground="#8C8C8C" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PriorityText}"
                                                       Foreground="#1677FF" FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>

                <!-- 选中墙体信息 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="选中墙体" Foreground="#8C8C8C" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#262626" FontSize="13" FontWeight="SemiBold">
                            <Run Text="{Binding SelectedWall.WallId, FallbackValue=---}"/>
                            <Run Text="  "/><Run Text="{Binding SelectedWall.ProjectName, FallbackValue={}}" Foreground="#8C8C8C"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 异常类型 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="异常类型" Foreground="#8C8C8C"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ExceptionTypes}"
                                  SelectedValue="{Binding SelectedExceptionType}"
                                  DisplayMemberPath="Name" SelectedValuePath="Value"
                                  Style="{StaticResource BaseComboBoxStyle}"
                                  Background="White" Foreground="#262626"
                                  BorderBrush="#D9D9D9" Height="28"/>
                        <TextBox Grid.Column="2" Margin="12,0,0,0"
                                 Text="{Binding CustomExceptionType, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#262626" Background="White"
                                 BorderBrush="#D9D9D9" Height="28"
                                 VerticalContentAlignment="Center"
                                 Visibility="{Binding IsCustomTypeVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- 登记员 + 发生时间 + 故障频次 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="登记员" Foreground="#8C8C8C"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RegistrantName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBoxStyle}"
                                     VerticalContentAlignment="Center" Height="28" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="故障频次" Foreground="#8C8C8C"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3"
                                     Text="{Binding FrequencyCount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBoxStyle}"
                                     VerticalContentAlignment="Center" Height="28"
                                     PreviewTextInput="NumberOnly_PreviewTextInput"
                                     DataObject.Pasting="NumberOnly_Pasting"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="发生时间" Foreground="#8C8C8C"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <DatePicker SelectedDate="{Binding OccurredAt, UpdateSourceTrigger=PropertyChanged}"
                                            Height="28" Width="160"
                                            VerticalContentAlignment="Center"/>
                                <TextBox Text="{Binding OccurredTime, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" Height="28" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 现场照片 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="现场照片" Foreground="#8C8C8C" FontSize="12"
                                       VerticalAlignment="Center" Width="80"/>
                            <Button Content="选择照片" Width="80" Height="28"
                                    Command="{Binding UploadPhotoCommand}"
                                    Style="{StaticResource BaseButtonStyle}"
                                    FontSize="11" Padding="8,2"/>
                            <Button Content="清除" Width="50" Height="28" Margin="6,0,0,0"
                                    Command="{Binding ClearPhotosCommand}"
                                    Style="{StaticResource BaseButtonStyle}"
                                    FontSize="11" Padding="8,2"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding PhotoPreviews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="80" Height="60" Margin="0,0,6,4"
                                                CornerRadius="4" Background="#F5F5F5"
                                                BorderBrush="#D9D9D9" BorderThickness="1">
                                            <Image Source="{Binding}" Stretch="Uniform"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="暂无照片" Foreground="#8C8C8C" FontSize="11"
                                       VerticalAlignment="Center" Margin="4,0,0,0"
                                       Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- 异常原因描述 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="故障描述" Foreground="#8C8C8C"
                                   FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Grid.Row="1"
                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#262626" Background="White"
                                 BorderBrush="#D9D9D9"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="100"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ 底部按钮 ═══════════════ -->
        <Border Grid.Row="1" Background="White" Padding="16,12"
                BorderBrush="#F0F0F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="提交" Width="80" Height="32" Margin="0,0,8,0"
                        Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="取消" Width="80" Height="32"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource BaseButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
