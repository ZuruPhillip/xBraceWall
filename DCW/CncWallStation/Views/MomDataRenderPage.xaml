<Page x:Class="CncWallStation.Views.MomDataRenderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:l="clr-namespace:CncWallStation.Localization"
      xmlns:vm="clr-namespace:CncWallStation.ViewModels" 
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1200"
      Title="{l:Loc PageTitle_MomRender}"
      FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: 标题+搜索栏 -->
            <RowDefinition Height="Auto"/> <!-- Row 1: 墙体详情行 -->
            <RowDefinition Height="Auto"/> <!-- Row 2: 工具栏 -->
            <RowDefinition Height="*"/>    <!-- Row 3: WebView2 -->
            <RowDefinition Height="32"/>   <!-- Row 4: 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════ -->
        <!--  Row 0 · 标题 + 搜索栏（合并）                -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Margin="8,8,8,6" Padding="16,10"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="4" Height="20" Background="#1890FF" CornerRadius="2" Margin="0,0,10,0"/>
                    <TextBlock Text="{l:Loc PageTitle_MomRender}" FontSize="18" FontWeight="Bold"
                               Foreground="#333" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧：搜索控件 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc Common_WallId}"
                               FontSize="13" Foreground="#666" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="300"
                             Style="{StaticResource BaseTextBoxStyle}"
                             Text="{Binding SearchWallId, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             ToolTip="{l:Loc Tooltip_SearchWallId}" TextChanged="TextBox_TextChanged">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchWallCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="{l:Loc Common_Search}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SearchWallCommand}"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--  Row 1 · 墙体详情行（搜索到才显示）           -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#E6F4FF"
                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"
                Padding="16,10"
                Visibility="{Binding IsWallFound, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Common_WallId}" Style="{StaticResource DetailLabelText}" Width="60"/>
                <TextBlock Text="{Binding DetailWallId}" Style="{StaticResource DetailValueText}" Width="280"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_Project}" Style="{StaticResource DetailLabelText}" Width="30"/>
                <TextBlock Text="{Binding DetailProject}" Style="{StaticResource DetailValueText}" Width="60"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_Floor}" Style="{StaticResource DetailLabelText}" Width="30"/>
                <TextBlock Text="{Binding DetailFloor}" Style="{StaticResource DetailValueText}" Width="60"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_Stage}" Style="{StaticResource DetailLabelText}" Width="30"/>
                <TextBlock Text="{Binding DetailStage}" Style="{StaticResource DetailValueText}" Width="100"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_Version}" Style="{StaticResource DetailLabelText}" Width="30"/>
                <TextBlock Text="{Binding DetailVersion}" Style="{StaticResource DetailValueText}" Width="50"/>

                <Separator Style="{x:Null}" Width="1" Background="#D9D9D9" Margin="12,0,12,0"/>

                <TextBlock Text="{l:Loc Common_ImportTime}" Style="{StaticResource DetailLabelText}" Width="50"/>
                <TextBlock Text="{Binding DetailImportTime}" Style="{StaticResource DetailValueText}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--  Row 2 · 工具栏                              -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#F0F0F0"
                BorderThickness="0,0,0,1" Padding="16,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 主操作 -->
                <Button Content="{l:Loc Button_LoadMomRender}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoadRenderCommand}"
                        ToolTip="{l:Loc Tooltip_LoadMomRender}"
                        Margin="0,0,4,0"/>

                <Separator Width="1" Height="20" Background="#F0F0F0"
                           Margin="4,0,8,0"/>

                <!-- 图层切换按钮 -->
                <ToggleButton Content="{l:Loc Toggle_Wall}"
                              Style="{StaticResource LayerToggleStyle}"
                              IsChecked="{Binding IsWallVisible}"
                              ToolTip="{l:Loc Tooltip_ToggleWallMom}"
                              Margin="0,0,2,0"/>
                <ToggleButton Content="{l:Loc Toggle_Cavity}"
                              Style="{StaticResource LayerToggleStyle}"
                              IsChecked="{Binding IsGrooveVisible}"
                              ToolTip="{l:Loc Tooltip_ToggleCavity}"
                              Margin="2,0,2,0"/>
                <ToggleButton Content="{l:Loc Toggle_MepSlot}"
                              Style="{StaticResource LayerToggleStyle}"
                              IsChecked="{Binding IsMepVisible}"
                              ToolTip="{l:Loc Tooltip_ToggleMep}"
                              Margin="2,0,2,0"/>
                <ToggleButton Content="{l:Loc Toggle_Rebar}"
                              Style="{StaticResource LayerToggleStyle}"
                              IsChecked="{Binding IsRebarVisible}"
                              ToolTip="{l:Loc Tooltip_ToggleRebarMom}"
                              Margin="2,0,2,0"/>
                <ToggleButton Content="{l:Loc Toggle_Dim}"
                              Style="{StaticResource LayerToggleStyle}"
                              IsChecked="{Binding IsDimVisible}"
                              ToolTip="{l:Loc Tooltip_ToggleDimMom}"
                              Margin="2,0,0,0"/>

                <Separator Width="1" Height="20" Background="#F0F0F0"
                           Margin="8,0,8,0"/>

                <!-- 原点变换 ToggleButton -->
                <ToggleButton Content="原点变换"
                              Style="{StaticResource LayerToggleStyle}"
                              IsChecked="{Binding IsOriginTransformed}"
                              IsEnabled="{Binding IsWallDataLoaded}"
                              ToolTip="基于当前MomJsonData数据做旋转和平移变换，方便与原数据对比"
                              Margin="0,0,2,0"/>

                <Separator Width="1" Height="20" Background="#F0F0F0"
                           Margin="8,0,8,0"/>

                <Button Content="{l:Loc Button_ResetView}"
                        Style="{StaticResource BaseButtonStyle}"
                        Command="{Binding ResetViewCommand}"
                        ToolTip="{l:Loc Tooltip_ResetView}"
                        Margin="0,0,4,0"/>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!--  Row 3 · WebView2 渲染区（全宽）               -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Row="3" Background="#0D0D1C">

            <!-- WebView2 -->
            <wv2:WebView2 x:Name="MomWebView"
                          NavigationCompleted="MomWebView_NavigationCompleted"
                          NavigationStarting="MomWebView_NavigationStarting"
                          CoreWebView2InitializationCompleted="MomWebView_CoreWebView2InitializationCompleted"/>

            <!-- 占位遮罩 -->
            <Border x:Name="PlaceholderPanel" Background="#0D0D1C" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x1F3D7;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="{l:Loc Placeholder_MomTitle}" FontSize="22" FontWeight="SemiBold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:Loc Placeholder_MomSubtitle}" FontSize="14" Foreground="#8888AA"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="{l:Loc Placeholder_MomHint}"
                               FontSize="13" Foreground="#555577"
                               HorizontalAlignment="Center" Margin="0,24,0,0"/>
                </StackPanel>
            </Border>

        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!--  Row 4 · 状态栏                              -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#BFBFBF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRendering}" Value="True">
                                        <Setter Property="Fill" Value="#52C41A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource AuxiliaryText}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{l:Loc StatusBar_MomModule}"
                           Style="{StaticResource AuxiliaryText}" Foreground="#D9D9D9" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
