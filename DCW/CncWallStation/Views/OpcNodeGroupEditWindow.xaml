<Window x:Class="CncWallStation.Views.OpcNodeGroupEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CncWallStation.Localization"
        Title="{Binding Title}"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,16,16,4">
            <TextBlock Text="{l:Loc OpcNode_GroupName}"
                       FontSize="12" Foreground="#8C8C8C" Margin="2,0,0,6"/>

            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource BaseTextBoxStyle}"
                     MaxLength="64"/>

            <Grid Margin="2,6,2,0">
                <TextBlock Text="{l:Loc OpcNode_GroupNameHint}"
                           FontSize="12" Foreground="#BFBFBF"
                           HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding NameLengthText}"
                           FontSize="12" Foreground="#BFBFBF"
                           HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Text="{l:Loc OpcNode_GroupDesc}"
                       FontSize="12" Foreground="#8C8C8C" Margin="2,14,0,6"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource BaseTextBoxStyle}"
                     MaxLength="256"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       FontSize="12" Foreground="#E60012"
                       TextWrapping="Wrap" Margin="2,8,2,0"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Loc Common_Cancel}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        MinWidth="84" Margin="0,0,10,0"/>
                <Button Content="{l:Loc Common_Save}"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="84" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
