<Window x:Class="CncWallStation.Views.OpcNodeImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CncWallStation.Localization"
        Title="{Binding Title}"
        Width="560"
        SizeToContent="Height"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,16,16,4">

            <!-- 文件路径 -->
            <Border Background="White" CornerRadius="6" BorderBrush="#E8E8E8" BorderThickness="1"
                    Padding="14,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{l:Loc OpcNode_ImportFilePath}"
                               FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding FilePath}"
                               FontSize="12" Foreground="#262626"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
            </Border>

            <!-- 统计条 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding AddedCount}" Style="{StaticResource StatValueStyle}" Foreground="#52C41A"/>
                        <TextBlock Text="{l:Loc OpcNode_ImportAdded}" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdatedCount}" Style="{StaticResource StatValueStyle}" Foreground="#1677FF"/>
                        <TextBlock Text="{l:Loc OpcNode_ImportUpdated}" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource StatValueStyle}" Foreground="#E67E22"/>
                        <TextBlock Text="{l:Loc OpcNode_ImportSkipped}" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 跳过明细 -->
            <Border Background="White" CornerRadius="6" BorderBrush="#E8E8E8" BorderThickness="1"
                    Padding="14,10"
                    Visibility="{Binding HasErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorHeader}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,0,6"/>

                    <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Errors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="12" Foreground="#8C8C8C"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 底部按钮 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E8E8E8" BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:Loc Common_Cancel}"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        MinWidth="88" Margin="0,0,10,0"/>
                <Button Content="{l:Loc OpcNode_ImportConfirm}"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="96" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
