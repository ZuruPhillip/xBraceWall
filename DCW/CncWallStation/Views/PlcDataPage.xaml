<Page x:Class="CncWallStation.Views.PlcDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:l="clr-namespace:CncWallStation.Localization"
      xmlns:local="clr-namespace:CncWallStation.Views"
      mc:Ignorable="d"
      Title="{l:Loc PageTitle_PlcData}"
      FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Page.Resources>
        <local:PlcBoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:PlcBoolInverseConverter x:Key="BoolInverseConverter" />
        <local:PlcAuditStatusToTextConverter x:Key="AuditStatusToTextConverter" />
        <local:PlcAuditStatusToColorConverter x:Key="AuditStatusToColorConverter" />
        <local:PlcInstructionCountConverter x:Key="InstructionCountConverter" />
        <local:PlcIntToBoolConverter x:Key="IntToBoolConverter" />
    </Page.Resources>

    <Grid Margin="8" Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Row0: 搜索栏 -->
            <RowDefinition Height="Auto" />   <!-- Row1: 墙体信息条 -->
            <RowDefinition Height="Auto" />   <!-- Row2: 操作按钮 -->
            <RowDefinition Height="*" />      <!-- Row3: 主内容区 -->
            <RowDefinition Height="Auto" />   <!-- Row4: 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ==================== Row0: 搜索栏 ==================== -->
        <Border Grid.Row="0" Padding="10" Margin="0,0,0,6"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="20" Background="#1890FF" CornerRadius="2" Margin="0,0,10,0" />
                <TextBlock Text="{l:Loc PageTitle_PlcData}" FontSize="18" FontWeight="Bold"
                           Foreground="#333" VerticalAlignment="Center" Margin="0,0,20,0" />
                <TextBlock Text="{l:Loc Label_WallIdPlc}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#666" />
                <TextBox x:Name="SearchBox" Width="300" Height="28"
                         Text="{Binding SearchWallId, UpdateSourceTrigger=PropertyChanged}"
                         hc:InfoElement.Placeholder="{l:Loc Placeholder_PlcSearch}"
                         Style="{StaticResource TextBoxExtend}"
                         KeyDown="SearchBox_OnKeyDown" />
                <Button Content="{l:Loc Common_Search}" Width="80" Height="28" Margin="8,0,0,0"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
        </Border>

        <!-- ==================== Row1: 墙体信息条 ==================== -->
        <Border Grid.Row="1" Padding="10,8" Margin="0,0,0,6"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Visibility="{Binding IsWallLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="{l:Loc Label_WallIdInfo}" Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.WallId}" FontWeight="Bold" Foreground="#333" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="{l:Loc Label_NameInfo}" Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.WallName}" FontWeight="Bold" Foreground="#333" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="{l:Loc Label_VersionInfo}" Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.SchemaVersion}" Foreground="#555" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="{l:Loc Label_AuditInfo}" Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.AuditStatus, Converter={StaticResource AuditStatusToTextConverter}}"
                               Foreground="{Binding WallInfo.AuditStatus, Converter={StaticResource AuditStatusToColorConverter}}"
                               FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="{l:Loc Label_ProjectInfo}" Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.ProjectName}" Foreground="#555" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="{l:Loc Label_FloorInfo}" Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.Floor}" Foreground="#555" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ==================== Row2: 操作按钮 ==================== -->
        <Border Grid.Row="2" Padding="8" Margin="0,0,0,6"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Visibility="{Binding IsWallLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <!-- 审核（已审核时置灰） -->
                <Button Content="{l:Loc Button_Audit}" Width="100" Height="30" Margin="0,0,6,0"
                        Command="{Binding AuditCommand}"
                        IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}"
                        Style="{StaticResource ButtonDefault}" />
                <Button Content="{l:Loc Button_UnauditPlc}" Width="100" Height="30" Margin="0,0,6,0"
                        Command="{Binding UnauditCommand}"
                        IsEnabled="{Binding IsAudited}"
                        Style="{StaticResource ButtonDefault}" />

                <Rectangle Width="1" Fill="#E0E0E0" Margin="6,4" />

                <Button Content="{l:Loc Button_SendCommand}" Width="110" Height="30" Margin="6,0,6,0"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource ButtonDefault}" />
                <Button Content="{l:Loc Button_Regenerate}" Width="110" Height="30" Margin="0,0,6,0"
                        Command="{Binding RegenerateCommand}"
                        IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}"
                        Style="{StaticResource ButtonDefault}" />
                <Button Content="{l:Loc Button_SaveDraft}" Width="110" Height="30" Margin="0,0,6,0"
                        Command="{Binding SaveDraftCommand}"
                        IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}"
                        Style="{StaticResource ButtonDefault}" />
            </StackPanel>
        </Border>

        <!-- ==================== Row3: 主内容区 ==================== -->
        <Grid Grid.Row="3"
              Visibility="{Binding IsWallLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧面板：统计 + 特征列表 -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 实际尺寸面板 -->
                <Border Grid.Row="0" Padding="10" Margin="0,0,0,6"
                        Background="White" CornerRadius="4"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{l:Loc Label_ActualDimensions}" FontWeight="Bold" FontSize="14"
                                   Margin="0,0,0,8" Foreground="#1890FF" />
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{l:Loc Label_ActualLength}" Foreground="Gray"
                                           VerticalAlignment="Center" Width="20" />
                                <TextBox Text="{Binding WallActualLength, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" Height="24" VerticalContentAlignment="Center" Margin="6,0,0,0"
                                         IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}" />
                                <TextBlock Text="mm" Foreground="Gray" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{l:Loc Label_ActualWidth}" Foreground="Gray"
                                           VerticalAlignment="Center" Width="20" />
                                <TextBox Text="{Binding WallActualWidth, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" Height="24" VerticalContentAlignment="Center" Margin="6,0,0,0"
                                         IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}" />
                                <TextBlock Text="mm" Foreground="Gray" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:Loc Label_ActualHeight}" Foreground="Gray"
                                           VerticalAlignment="Center" Width="20" />
                                <TextBox Text="{Binding WallActualHeight, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}"
                                         Width="80" Height="24" VerticalContentAlignment="Center" Margin="6,0,0,0"
                                         IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}" />
                                <TextBlock Text="mm" Foreground="Gray" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 正反面切换 -->
                <Border Grid.Row="1" Padding="10,6" Margin="0,0,0,6"
                        Background="White" CornerRadius="4"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="加工面：" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,8,0" />
                        <RadioButton Content="正面" VerticalAlignment="Center" Margin="0,0,12,0"
                                     IsChecked="{Binding SelectedSide, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0, Mode=TwoWay}"
                                     GroupName="SideSelector" />
                        <RadioButton Content="反面" VerticalAlignment="Center"
                                     IsChecked="{Binding SelectedSide, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1, Mode=TwoWay}"
                                     GroupName="SideSelector" />
                    </StackPanel>
                </Border>

                <!-- 特征分组标题 -->
                <TextBlock Grid.Row="2" Margin="2,0,0,6" Foreground="Gray">
                    <Run Text="{l:Loc Label_FeatureGroups}" />
                    <Run Text="{Binding FeatureGroups.Count, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="{l:Loc Label_FeatureGroupsSuffix}" />
                </TextBlock>

                <!-- 特征列表 -->
                <ListBox Grid.Row="3"
                         ItemsSource="{Binding FeatureGroups}"
                         SelectedItem="{Binding SelectedGroup}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,3" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" CornerRadius="4"
                                    Background="White" Cursor="Hand"
                                    BorderBrush="#E8E8E8" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                               Fill="#1890FF"
                                               VerticalAlignment="Stretch" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding FeatureName}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="#333" />
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="10"
                                            Background="#1890FF">
                                        <TextBlock Text="{Binding InstructionCount}"
                                                   FontSize="11" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent" />


            <!-- 右侧面板：TabControl + 审核图片 -->
            <Grid Grid.Column="2">
                <!-- 审核水印图片（表头下方右上角，与 ControllerPage "未连接"图片大小一致） -->
                <Image Source="pack://application:,,,/Resources/Images/audit.png"
                       Width="150" Height="90"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,-100,12,0" Opacity="1"
                       Visibility="{Binding IsAudited, Converter={StaticResource BoolToVisibilityConverter}}"
                       Panel.ZIndex="1" RenderTransformOrigin="0.674,0.5"/>

                <!-- 右侧主内容：TabControl -->
                <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                            Background="White"
                            Style="{StaticResource TabControlCapsule}">
                <!-- Tab1: 指令表格 -->
                <TabItem Header="{l:Loc Tab_InstructionData}">
                    <DataGrid ItemsSource="{Binding CurrentInstructions}"
                              SelectedItem="{Binding SelectedInstruction}"
                              AutoGenerateColumns="False"
                              IsReadOnly="{Binding IsAudited}"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="50" IsReadOnly="True"
                                                Binding="{Binding SortOrder}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="Gray" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="T" Width="60"
                                                Binding="{Binding T, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="F" Width="60"
                                                Binding="{Binding F, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="D" Width="60"
                                                Binding="{Binding D, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="X0" Width="80"
                                                Binding="{Binding X0, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Y0" Width="80"
                                                Binding="{Binding Y0, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Z0" Width="80"
                                                Binding="{Binding Z0, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="X1" Width="80"
                                                Binding="{Binding X1, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Y1" Width="80"
                                                Binding="{Binding Y1, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Z1" Width="80"
                                                Binding="{Binding Z1, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Tab2: 3D 渲染 -->
                <TabItem Header="{l:Loc Tab_3DRender}">
                    <Grid>
                        <wv2:WebView2 x:Name="PlcWebView"
                                      NavigationCompleted="PlcWebView_NavigationCompleted"
                                      CoreWebView2InitializationCompleted="PlcWebView_CoreWebView2InitializationCompleted" />
                    </Grid>
                </TabItem>
            </TabControl>
            </Grid>
        </Grid>

        <!-- ==================== Row4: 状态栏 ==================== -->
        <Border Grid.Row="4" Padding="10,6" Margin="0,6,0,0"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <TextBlock Foreground="Gray" FontSize="12">
                <Run Text="{l:Loc Status_TotalInstructions}" />
                <Run Text="{Binding CurrentInstructions.Count, Mode=OneWay}" FontWeight="Bold" Foreground="#333" />
                <Run Text="{l:Loc Status_SelectedFeature}" />
                <Run Text="{Binding SelectedGroup.FeatureName, Mode=OneWay, TargetNullValue=--}" FontWeight="Bold" Foreground="#1890FF" />
                <Run Text="{l:Loc Status_ToolChange}" />
                <Run Text="{Binding Statistics.ToolChangeCount, Mode=OneWay}" FontWeight="Bold" Foreground="#333" />
                <Run Text="{l:Loc Status_Times}" />
                <Run Text="{Binding Statistics.TotalCuttingArea, StringFormat={}{0:F0}, Mode=OneWay}" FontWeight="Bold" Foreground="#333" />
                <Run Text="{l:Loc Status_AreaSuffix}" />
                <Run Text="{Binding Statistics.EstimatedHours, StringFormat={}{0:F1}, Mode=OneWay}" FontWeight="Bold" Foreground="#333" />
                <Run Text="{l:Loc Status_TimeSuffix}" />
            </TextBlock>
        </Border>
    </Grid>
</Page>
