<Page x:Class="CncWallStation.Views.PlcDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:local="clr-namespace:CncWallStation.Views"
      mc:Ignorable="d"
      Title="PLC指令单元"
      FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Page.Resources>
        <local:PlcBoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:PlcBoolInverseConverter x:Key="BoolInverseConverter" />
        <local:PlcAuditStatusToTextConverter x:Key="AuditStatusToTextConverter" />
        <local:PlcAuditStatusToColorConverter x:Key="AuditStatusToColorConverter" />
    </Page.Resources>

    <Grid Margin="8" Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Row0: 搜索栏 -->
            <RowDefinition Height="Auto" />   <!-- Row1: 墙体信息条 -->
            <RowDefinition Height="Auto" />   <!-- Row2: 操作按钮 -->
            <RowDefinition Height="*" />      <!-- Row3: 主内容区 -->
            <RowDefinition Height="Auto" />   <!-- Row4: 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ==================== Row0: 搜索栏 ==================== -->
        <Border Grid.Row="0" Padding="10" Margin="0,0,0,6"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="20" Background="#1890FF" CornerRadius="2" Margin="0,0,10,0" />
                <TextBlock Text="PLC 指令单元" FontSize="18" FontWeight="Bold"
                           Foreground="#333" VerticalAlignment="Center" Margin="0,0,20,0" />
                <TextBlock Text="墙体 ID:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#666" />
                <TextBox x:Name="SearchBox" Width="300" Height="28"
                         Text="{Binding SearchWallId, UpdateSourceTrigger=PropertyChanged}"
                         hc:InfoElement.Placeholder="输入墙体 ID 回车搜索"
                         Style="{StaticResource TextBoxExtend}"
                         KeyDown="SearchBox_OnKeyDown" />
                <Button Content="搜索" Width="70" Height="28" Margin="8,0,0,0"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
        </Border>

        <!-- ==================== Row1: 墙体信息条 ==================== -->
        <Border Grid.Row="1" Padding="10,8" Margin="0,0,0,6"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Visibility="{Binding IsWallLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="墙体 ID: " Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.WallId}" FontWeight="Bold" Foreground="#333" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="名称: " Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.WallName}" FontWeight="Bold" Foreground="#333" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="版本: " Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.SchemaVersion}" Foreground="#555" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="审核: " Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.AuditStatus, Converter={StaticResource AuditStatusToTextConverter}}"
                               Foreground="{Binding WallInfo.AuditStatus, Converter={StaticResource AuditStatusToColorConverter}}"
                               FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="项目号: " Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.ProjectName}" Foreground="#555" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="楼层: " Foreground="Gray" />
                    <TextBlock Text="{Binding WallInfo.Floor}" Foreground="#555" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ==================== Row2: 操作按钮 ==================== -->
        <Border Grid.Row="2" Padding="8" Margin="0,0,0,6"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Visibility="{Binding IsWallLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <!-- 审核（已审核时置灰） -->
                <Button Content="审核" Width="70" Height="30" Margin="0,0,6,0"
                        Command="{Binding AuditCommand}"
                        IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}"
                        Style="{StaticResource ButtonDefault}" />
                <!-- 反审核（未审核时置灰） -->
                <Button Content="反审核" Width="70" Height="30" Margin="0,0,6,0"
                        Command="{Binding UnauditCommand}"
                        IsEnabled="{Binding IsAudited}"
                        Style="{StaticResource ButtonDefault}" />

                <Rectangle Width="1" Fill="#E0E0E0" Margin="6,4" />

                <!-- 下发指令 -->
                <Button Content="下发指令" Width="80" Height="30" Margin="6,0,6,0"
                        Command="{Binding SendCommand}"
                        Style="{StaticResource ButtonDefault}" />
                <!-- 重新生成（未审核时可用） -->
                <Button Content="重新生成" Width="80" Height="30" Margin="0,0,6,0"
                        Command="{Binding RegenerateCommand}"
                        IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}"
                        Style="{StaticResource ButtonDefault}" />
                <!-- 保存草稿（未审核时可用） -->
                <Button Content="保存草稿" Width="80" Height="30" Margin="0,0,6,0"
                        Command="{Binding SaveDraftCommand}"
                        IsEnabled="{Binding IsAudited, Converter={StaticResource BoolInverseConverter}}"
                        Style="{StaticResource ButtonDefault}" />
                <!-- 清空面板（始终可用） -->
                <Button Content="清空面板" Width="80" Height="30" Margin="6,0,0,0"
                        Command="{Binding ClearPanelCommand}"
                        Style="{StaticResource ButtonDefault}" />
            </StackPanel>
        </Border>

        <!-- ==================== Row3: 主内容区 ==================== -->
        <Grid Grid.Row="3"
              Visibility="{Binding IsWallLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧面板：统计 + 特征列表 -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 统计卡片 -->
                <Border Grid.Row="0" Padding="10" Margin="0,0,0,6"
                        Background="White" CornerRadius="4"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="加工统计" FontWeight="Bold" FontSize="14"
                                   Margin="0,0,0,8" Foreground="#1890FF" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 总指令条数 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="总指令" Foreground="Gray" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Statistics.TotalInstructionCount, StringFormat={}{0} 条}"
                                       HorizontalAlignment="Right" Foreground="Gray" />

                            <!-- 换刀次数 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="换刀次数" Foreground="Gray"
                                       Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding Statistics.ToolChangeCount}"
                                       HorizontalAlignment="Right" FontWeight="Bold"
                                       Foreground="Orange" Margin="0,4,0,0" />

                            <!-- 总切削面积 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="切削面积" Foreground="Gray"
                                       Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding Statistics.TotalCuttingArea, StringFormat={}{0:F0} mm²}"
                                       HorizontalAlignment="Right" FontWeight="Bold"
                                       Foreground="DodgerBlue" Margin="0,4,0,0" />

                            <!-- 预估工时 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="预估工时" Foreground="Gray"
                                       Margin="0,4,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{Binding Statistics.EstimatedHours, StringFormat={}{0:F1} min}"
                                       HorizontalAlignment="Right" FontWeight="Bold"
                                       Foreground="Green" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 特征分组标题 -->
                <TextBlock Grid.Row="1" Margin="2,0,0,6" Foreground="Gray">
                    <Run Text="特征分组 (" />
                    <Run Text="{Binding FeatureGroups.Count, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text=" 组)" />
                </TextBlock>

                <!-- 特征列表 -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding FeatureGroups}"
                         SelectedItem="{Binding SelectedGroup}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,3" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8" CornerRadius="4"
                                    Background="White" Cursor="Hand"
                                    BorderBrush="#E8E8E8" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2"
                                               Fill="#1890FF"
                                               VerticalAlignment="Stretch" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding FeatureName}"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="#333" />
                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="10"
                                            Background="#1890FF">
                                        <TextBlock Text="{Binding InstructionCount}"
                                                   FontSize="11" Foreground="White"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 分割线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent" />

            <!-- 右侧主内容：TabControl -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex}"
                        Background="White"
                        Style="{StaticResource TabControlCapsule}">
                <!-- Tab1: 指令表格 -->
                <TabItem Header="指令数据">
                    <DataGrid ItemsSource="{Binding CurrentInstructions}"
                              SelectedItem="{Binding SelectedInstruction}"
                              AutoGenerateColumns="False"
                              IsReadOnly="{Binding IsAudited}"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Width="50" IsReadOnly="True"
                                                Binding="{Binding SortOrder}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="Gray" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="T" Width="60"
                                                Binding="{Binding T, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="F" Width="60"
                                                Binding="{Binding F, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="D" Width="60"
                                                Binding="{Binding D, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="X0" Width="80"
                                                Binding="{Binding X0, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Y0" Width="80"
                                                Binding="{Binding Y0, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Z0" Width="80"
                                                Binding="{Binding Z0, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="X1" Width="80"
                                                Binding="{Binding X1, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Y1" Width="80"
                                                Binding="{Binding Y1, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Z1" Width="80"
                                                Binding="{Binding Z1, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Tab2: 3D 渲染 -->
                <TabItem Header="3D 渲染">
                    <Grid>
                        <wv2:WebView2 x:Name="PlcWebView"
                                      NavigationCompleted="PlcWebView_NavigationCompleted"
                                      CoreWebView2InitializationCompleted="PlcWebView_CoreWebView2InitializationCompleted" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ==================== Row4: 状态栏 ==================== -->
        <Border Grid.Row="4" Padding="10,6" Margin="0,6,0,0"
                Background="White" CornerRadius="4"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <TextBlock Foreground="Gray" FontSize="12">
                <Run Text="总指令: " />
                <Run Text="{Binding CurrentInstructions.Count, Mode=OneWay}" FontWeight="Bold" Foreground="#333" />
                <Run Text=" | 选中特征: " />
                <Run Text="{Binding SelectedGroup.FeatureName, Mode=OneWay, TargetNullValue=--}" FontWeight="Bold" Foreground="#1890FF" />
                <Run Text=" | 换刀: " />
                <Run Text="{Binding Statistics.ToolChangeCount, Mode=OneWay}" FontWeight="Bold" Foreground="#333" />
                <Run Text=" 次 | 面积: " />
                <Run Text="{Binding Statistics.TotalCuttingArea, StringFormat={}{0:F0}, Mode=OneWay}" FontWeight="Bold" Foreground="#333" />
                <Run Text=" mm² | 工时: " />
                <Run Text="{Binding Statistics.EstimatedHours, StringFormat={}{0:F1}, Mode=OneWay}" FontWeight="Bold" Foreground="#333" />
                <Run Text=" min" />
            </TextBlock>
        </Border>
    </Grid>
</Page>
