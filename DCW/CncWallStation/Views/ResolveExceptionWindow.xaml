<Window x:Class="CncWallStation.Views.ResolveExceptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, FallbackValue=解决异常}"
        Width="520" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ 表单内容 ═══════════════ -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="16,16,16,8">
            <StackPanel>

                <!-- 维修方法 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="维修方法" Foreground="#262626" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding RepairMethod, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#262626" Background="White"
                                 BorderBrush="#D9D9D9" Height="28"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource BaseTextBoxStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 解决人员 + 维修耗时 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="解决人员" Foreground="#8C8C8C"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Resolver, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BaseTextBoxStyle}"
                                 VerticalContentAlignment="Center" Height="28" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="维修耗时" Foreground="#8C8C8C"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <Grid Grid.Column="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding RepairDurationText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource BaseTextBoxStyle}"
                                     VerticalContentAlignment="Center" Height="28"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"
                                     DataObject.Pasting="DecimalOnly_Pasting"/>
                            <TextBlock Grid.Column="1" Text="h" Foreground="#8C8C8C" FontSize="12"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 完成时间 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="完成时间" Foreground="#8C8C8C"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <DatePicker SelectedDate="{Binding CompletionTime, UpdateSourceTrigger=PropertyChanged}"
                                        Height="28" Width="160"
                                        VerticalContentAlignment="Center"/>
                            <TextBlock Text="{Binding CompletionTime, StringFormat='HH:mm:ss'}"
                                       Foreground="#262626" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 机构改善建议 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="机构改善建议" Foreground="#262626" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ImprovementSuggestion, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#262626" Background="White"
                                 BorderBrush="#D9D9D9"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="80"/>
                    </StackPanel>
                </Border>

                <!-- 备注 -->
                <Border Background="White" CornerRadius="4" Padding="16"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="备注" Foreground="#262626" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 Foreground="#262626" Background="White"
                                 BorderBrush="#D9D9D9"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="60"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════ 底部按钮 ═══════════════ -->
        <Border Grid.Row="1" Background="White" Padding="16,12"
                BorderBrush="#F0F0F0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="提交" Width="80" Height="32" Margin="0,0,8,0"
                        Command="{Binding SubmitCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="取消" Width="80" Height="32"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource BaseButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
