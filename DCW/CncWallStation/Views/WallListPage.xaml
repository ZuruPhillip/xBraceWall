<Page x:Class="CncWallStation.Views.WallListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CncWallStation.Views"
      xmlns:l="clr-namespace:CncWallStation.Localization"
      xmlns:models="clr-namespace:CncWallStation.Models"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1600"
      Title="{l:Loc PageTitle_WallList}"
      FontFamily="Segoe UI, PingFang SC, Microsoft YaHei">

	<Page.Resources>
		<!-- 页面专用转换器 -->
		<local:PriorityToBrushConverter x:Key="PriorityToBrushConverter"/>
		<local:PriorityIntToTextConverter x:Key="PriorityIntToTextConverter"/>
		<local:PriorityToTextConverter x:Key="PriorityToTextConverter"/>
		<local:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
		<local:StatusToTextConverter x:Key="StatusToTextConverter"/>
		<local:PipelineStageToBrushConverter x:Key="PipelineStageToBrushConverter"/>
		<local:PipelineStageToTextConverter x:Key="PipelineStageToTextConverter"/>
		<local:AuditStatusToBrushConverter x:Key="AuditStatusToBrushConverter"/>
		<local:AuditStatusToTextConverter x:Key="AuditStatusToTextConverter"/>
		<local:PriorityToOutlineBrushConverter x:Key="PriorityToOutlineBrushConverter"/>
		<local:StatusToLightBrushConverter x:Key="StatusToLightBrushConverter"/>
		<local:StatusToDarkBrushConverter x:Key="StatusToDarkBrushConverter"/>
		<local:AuditStatusToLightBrushConverter x:Key="AuditStatusToLightBrushConverter"/>
		<local:AuditStatusToDarkBrushConverter x:Key="AuditStatusToDarkBrushConverter"/>
		<local:IsLatestToTextConverter x:Key="IsLatestToTextConverter"/>
		<local:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
		<local:BoolInvertConverter x:Key="BoolInvertConverter"/>

		<!-- 优先级 Tag 模板（左侧风格：白底 + 彩色描边 + 彩色文字） -->
		<DataTemplate x:Key="PriorityTagTemplate">
			<Border CornerRadius="3" Margin="2" Padding="6,2"
					Background="White"
					BorderBrush="{Binding Priority, Converter={StaticResource PriorityToOutlineBrushConverter}}"
					BorderThickness="1">
				<TextBlock Text="{Binding Priority, Converter={StaticResource PriorityIntToTextConverter}}"
						   Foreground="{Binding Priority, Converter={StaticResource PriorityToOutlineBrushConverter}}"
						   FontSize="12" FontWeight="SemiBold"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>
		</DataTemplate>

		<!-- 状态 Tag 模板（右侧风格：浅色背景 + 深色文字） -->
		<DataTemplate x:Key="StatusTagTemplate">
			<Border CornerRadius="3" Margin="2" Padding="6,2"
					Background="{Binding Status, Converter={StaticResource StatusToLightBrushConverter}}">
				<TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}"
						   Foreground="{Binding Status, Converter={StaticResource StatusToDarkBrushConverter}}"
						   FontSize="12" FontWeight="SemiBold"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>
		</DataTemplate>

		<!-- 管线阶段 Tag 模板（纯色背景 + 白色文字） -->
		<DataTemplate x:Key="PipelineStageTagTemplate">
			<Border CornerRadius="3" Margin="2" Padding="6,2"
					Background="{Binding PipelineStage, Converter={StaticResource PipelineStageToBrushConverter}}">
				<TextBlock Text="{Binding PipelineStageText}"
						   Foreground="White"
						   FontSize="12" FontWeight="SemiBold"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>
		</DataTemplate>

		<!-- 审核状态 Tag 模板（右侧风格：浅色背景 + 深色文字） -->
		<DataTemplate x:Key="AuditStatusTagTemplate">
			<Border CornerRadius="3" Margin="2" Padding="6,2"
					Background="{Binding AuditStatus, Converter={StaticResource AuditStatusToLightBrushConverter}}">
				<TextBlock Text="{Binding AuditStatusText}"
						   Foreground="{Binding AuditStatus, Converter={StaticResource AuditStatusToDarkBrushConverter}}"
						   FontSize="12" FontWeight="SemiBold"
						   HorizontalAlignment="Center" VerticalAlignment="Center"/>
			</Border>
		</DataTemplate>
	</Page.Resources>

	<Grid Background="#F5F5F5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>  <!-- 标题栏 -->
			<RowDefinition Height="Auto"/>  <!-- 工具栏 -->
			<RowDefinition Height="Auto"/>  <!-- 筛选栏 -->
			<RowDefinition Height="*"/>     <!-- 数据表格 -->
			<RowDefinition Height="Auto"/>  <!-- 分页栏 -->
		</Grid.RowDefinitions>

		<!-- ══════════════════════════════════════════ -->
		<!--  标题栏                                     -->
		<!-- ══════════════════════════════════════════ -->
		<Border Grid.Row="0" Margin="8,8,8,6" Padding="12,10"
				Background="White" CornerRadius="4"
				BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
				<Border Width="4" Height="20" Background="#1890FF" CornerRadius="2" Margin="0,0,10,0" />
				<TextBlock Text="{l:Loc PageTitle_WallList}" FontSize="18" FontWeight="Bold"
						   Foreground="#333" VerticalAlignment="Center" />
			</StackPanel>
		</Border>

		<!-- ══════════════════════════════════════════ -->
		<!--  工具栏                                     -->
		<!-- ══════════════════════════════════════════ -->
		<Border Grid.Row="1" Padding="12,10" Background="#FFFFFF"
				BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
			<Grid>
				<WrapPanel Cursor="">
					<!-- 导入 -->
				<Button Content="{l:Loc Button_BatchImport}"
						Command="{Binding ImportCommand}"
						Style="{StaticResource BaseButtonStyle}"
						Width="130" Margin="0,0,4,2"
						IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvertConverter}}"
						ToolTip="{l:Loc Tooltip_BatchImport}"/>

				<Button Content="{l:Loc Button_SingleImport}"
						Command="{Binding ImportSingleWallCommand}"
						Style="{StaticResource BaseButtonStyle}"
						Width="130" Margin="0,0,4,2"
						IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvertConverter}}"
						ToolTip="{l:Loc Tooltip_SingleImport}"/>

				<Separator Style="{x:Null}" Width="1" Height="20" Background="#F0F0F0" Margin="4,0"/>

				<Button Content="{l:Loc Button_ExecutePipeline}"
						Command="{Binding ExecutePipelineCommand}"
						Style="{StaticResource BaseButtonStyle}"
						Width="130" Margin="0,0,4,2"
						IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvertConverter}}"
						ToolTip="{l:Loc Tooltip_ExecutePipeline}"/>

				<Separator Style="{x:Null}" Width="1" Height="20" Background="#F0F0F0" Margin="4,0"/>

				<Button Content="{l:Loc Button_Audit}"
						Command="{Binding AuditSelectedCommand}"
						Style="{StaticResource BaseButtonStyle}"
						Width="110" Margin="0,0,4,2"
						IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvertConverter}}"
						ToolTip="{l:Loc Tooltip_Audit}"/>

				<Button Content="{l:Loc Button_Unaudit}"
						Command="{Binding UnauditSelectedCommand}"
						Style="{StaticResource BaseButtonStyle}"
						Width="110" Margin="0,0,4,2"
						IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvertConverter}}"
						ToolTip="{l:Loc Tooltip_Unaudit}"/>

				<Separator Style="{x:Null}" Width="1" Height="20" Background="#F0F0F0" Margin="4,0"/>

				<Button Content="{l:Loc Button_IncreasePriority}"
						Command="{Binding IncreasePriorityCommand}"
						Style="{StaticResource BaseButtonStyle}"
						Width="100" Margin="0,0,2,2"
						IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvertConverter}}"/>

				<Button Content="{l:Loc Button_DecreasePriority}"
						Command="{Binding DecreasePriorityCommand}"
						Style="{StaticResource BaseButtonStyle}"
						Width="100" Margin="0,0,4,2"
						IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInvertConverter}}"/>
				</WrapPanel>

				<!-- 加载指示器 -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
							Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
					<ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,8,0"/>
					<TextBlock Text="{l:Loc Common_Loading}" VerticalAlignment="Center" FontSize="12" Foreground="#8C8C8C"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══════════════════════════════════════════ -->
		<!--  筛选栏                                     -->
		<!-- ══════════════════════════════════════════ -->
		<Border Grid.Row="2" Padding="12,10" Background="#FAFAFA"
				BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
			<WrapPanel>

				<!-- 项目名称 -->
				<StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                    <TextBlock Text="{l:Loc Label_ProjectName}" Style="{StaticResource FilterLabelText}" Margin="0,0,6,0"/>
					<TextBox Text="{Binding SearchProjectName, UpdateSourceTrigger=PropertyChanged}"
							 Style="{StaticResource BaseTextBoxStyle}" Height="28" Width="110"/>
				</StackPanel>

				<!-- 楼层 -->
				<StackPanel Orientation="Horizontal" Margin="0,0,16,4">
					<TextBlock Text="{l:Loc Label_Floor}" Style="{StaticResource FilterLabelText}" Margin="0,0,6,0"/>
					<ComboBox ItemsSource="{Binding AvailableFloors}"
							  SelectedValue="{Binding FilterFloor}"
							  Style="{StaticResource BaseComboBoxStyle}" Height="28" Width="70"/>
				</StackPanel>

				<!-- 墙体ID -->
				<StackPanel Orientation="Horizontal" Margin="0,0,16,4">
					<TextBlock Text="{l:Loc Label_WallId}" Style="{StaticResource FilterLabelText}" Margin="0,0,6,0"/>
					<TextBox Text="{Binding SearchWallId, UpdateSourceTrigger=PropertyChanged}"
							 Style="{StaticResource BaseTextBoxStyle}" Height="28" Width="130"/>
				</StackPanel>

				<!-- 墙体名称 -->
				<StackPanel Orientation="Horizontal" Margin="0,0,16,4">
					<TextBlock Text="{l:Loc Label_WallName}" Style="{StaticResource FilterLabelText}" Margin="0,0,6,0"/>
					<TextBox Text="{Binding SearchWallName, UpdateSourceTrigger=PropertyChanged}"
							 Style="{StaticResource BaseTextBoxStyle}" Height="28" Width="110"/>
				</StackPanel>

				<!-- 生产状态 -->
				<StackPanel Orientation="Horizontal" Margin="0,0,16,4">
					<TextBlock Text="{l:Loc Label_Status}" Style="{StaticResource FilterLabelText}" Margin="0,0,6,0"/>
					<ComboBox ItemsSource="{Binding AllStatuses}"
							  SelectedValue="{Binding FilterStatus}"
							  Style="{StaticResource BaseComboBoxStyle}" Height="28" Width="100"
							  SelectionChanged="StatusComboBox_SelectionChanged">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Converter={StaticResource StatusToTextConverter}}" FontSize="12"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>

				<!-- 加工优先级 -->
				<StackPanel Orientation="Horizontal" Margin="0,0,16,4">
					<TextBlock Text="{l:Loc Label_Priority}" Style="{StaticResource FilterLabelText}" Margin="0,0,6,0"/>
					<ComboBox ItemsSource="{Binding AllPriorities}"
							  SelectedValue="{Binding FilterPriority}"
							  Style="{StaticResource BaseComboBoxStyle}" Height="28" Width="80"
							  SelectionChanged="PriorityComboBox_SelectionChanged">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Converter={StaticResource PriorityToTextConverter}}" FontSize="12"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>



				<!-- 审核状态 -->
				<StackPanel Orientation="Horizontal" Margin="0,0,16,4">
					<TextBlock Text="{l:Loc Label_AuditStatus}" Style="{StaticResource FilterLabelText}" Margin="0,0,6,0"/>
					<ComboBox ItemsSource="{Binding AllAuditStatuses}"
							  SelectedValue="{Binding FilterAuditStatus}"
							  Style="{StaticResource BaseComboBoxStyle}" Height="28" Width="90"
							  SelectionChanged="AuditStatusComboBox_SelectionChanged">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding Converter={StaticResource AuditStatusToTextConverter}}" FontSize="11"/>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>



				<!-- 生产结束时间范围 -->
				<StackPanel Orientation="Horizontal" Margin="0,0,16,4">
					<TextBlock Text="{l:Loc Label_EndProductionTime}" Style="{StaticResource FilterLabelText}" Margin="0,0,6,0"/>
					<DatePicker SelectedDate="{Binding FilterDateFrom}" Width="110" Height="28"/>
					<TextBlock Text="—" VerticalAlignment="Center" Margin="4,0" FontSize="12" Foreground="#8C8C8C"/>
					<DatePicker SelectedDate="{Binding FilterDateTo}" Width="110" Height="28"/>
				</StackPanel>

				<!-- 搜索/重置 -->
				<StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
					<Button Content="{l:Loc Common_Search}"
							Command="{Binding SearchCommand}"
							Style="{StaticResource PrimaryButtonStyle}"
							Height="28" Width="110" Margin="0,0,4,0"/>
					<Button Content="{l:Loc Button_ResetFilter}"
							Command="{Binding ResetFilterCommand}"
							Style="{StaticResource BaseButtonStyle}"
							Height="28" Width="110"/>
				</StackPanel>
			</WrapPanel>
		</Border>

		<!-- ══════════════════════════════════════════ -->
		<!--  数据表格                                   -->
		<!-- ══════════════════════════════════════════ -->
		<DataGrid Grid.Row="3"
				  x:Name="WallDataGrid"
				  ItemsSource="{Binding DisplayItems}"
				  AutoGenerateColumns="False"
				  Style="{StaticResource LightDataGridStyle}"
				  CanUserSortColumns="False"
				  PreviewKeyDown="DataGrid_PreviewKeyDown"
				  PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
				  SelectionChanged="DataGrid_SelectionChanged">

			<DataGrid.ContextMenu>
				<ContextMenu>
					<MenuItem Header="{l:Loc ContextMenu_Copy}" Click="ContextMenu_CopyCell"
							  InputGestureText="Ctrl+C"/>
					<Separator/>
					<MenuItem Header="{l:Loc ContextMenu_RenameWall}" Click="ContextMenu_RenameWall"
							  Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
					<Separator/>
					<MenuItem Header="{l:Loc ContextMenu_ViewBimRender}" Click="ContextMenu_ViewDetail"/>
					<MenuItem Header="{l:Loc ContextMenu_ViewMomRender}" Click="ContextMenu_ViewMomRender"/>
					<MenuItem Header="{l:Loc ContextMenu_EditJson}" Click="ContextMenu_EditJson"/>
				</ContextMenu>
			</DataGrid.ContextMenu>

			<DataGrid.Columns>
				<!-- 复选框多选列（含列头全选） -->
				<DataGridTemplateColumn Width="40" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<CheckBox IsChecked="{Binding DataContext.IsAllSelected,
										RelativeSource={RelativeSource AncestorType=DataGrid}}"
									  IsThreeState="True"
									  Checked="HeaderCheckBox_Checked"
									  Unchecked="HeaderCheckBox_Unchecked"
									  HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									  Checked="RowCheckBox_Checked"
									  Unchecked="RowCheckBox_Unchecked"
									  HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 项目名称 -->
				<DataGridTemplateColumn Header="{l:Loc Column_ProjectName}" Width="130">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<Button Content="{l:Loc Column_ProjectName_Sort}" Background="Transparent" BorderThickness="0"
									Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									CommandParameter="ProjectName"
									Cursor="Hand" FontWeight="SemiBold" FontSize="12"
									Foreground="#262626"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding ProjectName}"
									  Foreground="#1677FF"
									  FontSize="13"
									  VerticalAlignment="Center"
									  ToolTip="{Binding ProjectName}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 楼层 -->
				<DataGridTemplateColumn Header="{l:Loc Column_Floor}" Width="100">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<Button Content="{l:Loc Column_Floor_Sort}" Background="Transparent" BorderThickness="0"
									Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									CommandParameter="Floor"
									Cursor="Hand" FontWeight="SemiBold" FontSize="12"
									Foreground="#262626"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Floor}" HorizontalAlignment="Center" FontSize="13"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 墙体ID -->
				<DataGridTemplateColumn Header="{l:Loc Column_WallId}" Width="150">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<Button Content="{l:Loc Column_WallId_Sort}" Background="Transparent" BorderThickness="0"
									Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									CommandParameter="WallId"
									Cursor="Hand" FontWeight="SemiBold" FontSize="12"
									Foreground="#262626"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding WallId}" FontFamily="Consolas" FontSize="11"
									  ToolTip="{Binding WallId}" TextTrimming="CharacterEllipsis"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 墙体名称 -->
				<DataGridTemplateColumn Header="{l:Loc Column_WallName}" Width="150">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<Button Content="{l:Loc Column_WallName_Sort}" Background="Transparent" BorderThickness="0"
									Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									CommandParameter="WallName"
									Cursor="Hand" FontWeight="SemiBold" FontSize="12"
									Foreground="#262626"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding WallName}" FontSize="13"
									  VerticalAlignment="Center"
									  TextTrimming="CharacterEllipsis"
									  ToolTip="{Binding WallName}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 开始生产时间 -->
                <DataGridTemplateColumn Header="{l:Loc Column_StartProductionTime}" Width="100">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding StartProductionTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
									  FontSize="11" HorizontalAlignment="Center"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 结束生产时间 -->
                <DataGridTemplateColumn Header="{l:Loc Column_EndProductionTime}" Width="100">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<Button Content="{l:Loc Column_EndProductionTime_Sort}" Background="Transparent" BorderThickness="0"
									Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									CommandParameter="EndProductionTime"
									Cursor="Hand" FontWeight="SemiBold" FontSize="12"
									Foreground="#262626"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding EndProductionTime, StringFormat='yyyy-MM-dd HH:mm:ss'}"
									  FontSize="11" HorizontalAlignment="Center"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 加工优先级 -->
				<DataGridTemplateColumn Header="{l:Loc Column_Priority}" Width="100">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<Button Content="{l:Loc Column_Priority_Sort}" Background="Transparent" BorderThickness="0"
									Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									CommandParameter="Priority"
									Cursor="Hand" FontWeight="SemiBold" FontSize="12"
									Foreground="#262626"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ContentPresenter ContentTemplate="{StaticResource PriorityTagTemplate}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>



				<!-- 生产状态 -->
				<DataGridTemplateColumn Header="{l:Loc Column_ProductionStatus}" Width="100">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<Button Content="{l:Loc Column_ProductionStatus_Sort}" Background="Transparent" BorderThickness="0"
									Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									CommandParameter="Status"
									Cursor="Hand" FontWeight="SemiBold" FontSize="12"
									Foreground="#262626"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ContentPresenter ContentTemplate="{StaticResource StatusTagTemplate}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>

				<!-- 审核状态 -->
				<DataGridTemplateColumn Header="{l:Loc Column_AuditStatus}" Width="100">
					<DataGridTemplateColumn.HeaderTemplate>
						<DataTemplate>
							<Button Content="{l:Loc Column_AuditStatus_Sort}" Background="Transparent" BorderThickness="0"
									Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
									CommandParameter="AuditStatus"
									Cursor="Hand" FontWeight="SemiBold" FontSize="12"
									Foreground="#262626"/>
						</DataTemplate>
					</DataGridTemplateColumn.HeaderTemplate>
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<ContentPresenter ContentTemplate="{StaticResource AuditStatusTagTemplate}"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>

		<!-- ══════════════════════════════════════════ -->
		<!--  空状态                                     -->
		<!-- ══════════════════════════════════════════ -->
		<Border Grid.Row="3" Background="#FAFAFA"
				Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisConverter}}">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
				<TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
				<TextBlock Text="{l:Loc Empty_NoData}" FontSize="16" HorizontalAlignment="Center" Foreground="#8C8C8C"/>
				<TextBlock Text="{l:Loc Empty_AdjustFilter}" FontSize="13" HorizontalAlignment="Center"
						   Foreground="#BFBFBF" Margin="0,4,0,0"/>
			</StackPanel>
		</Border>

		<!-- ══════════════════════════════════════════ -->
		<!--  分页栏                                     -->
		<!-- ══════════════════════════════════════════ -->
		<Border Grid.Row="4" Padding="12,8" Background="#FFFFFF"
				BorderBrush="#F0F0F0" BorderThickness="0,1,0,0">
			<Grid>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock FontSize="12" Foreground="#262626" VerticalAlignment="Center">
						<Run Text="{l:Loc Pagination_Total}"/>
						<Run Text="{Binding TotalItems}" FontWeight="Bold"/>
						<Run Text="{l:Loc Pagination_Records}"/>
					</TextBlock>
					<Border Width="1" Height="16" Background="#F0F0F0" Margin="12,0"/>
					<TextBlock Text="{l:Loc Pagination_PerPage}" VerticalAlignment="Center" FontSize="12" Foreground="#262626" Margin="0,0,4,0"/>
					<ComboBox ItemsSource="{Binding PageSizeOptions}"
							  SelectedValue="{Binding PageSize}"
							  Height="24" Width="65" FontSize="12"
							  SelectionChanged="PageSize_SelectionChanged"/>
					<TextBlock Text="{l:Loc Pagination_ItemsUnit}" VerticalAlignment="Center" FontSize="12" Foreground="#262626" Margin="4,0,0,0"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
					<Button Content="◀◀" Width="42" Height="28"
							Style="{StaticResource BaseButtonStyle}"
							Command="{Binding GoToPageCommand}" CommandParameter="1"
							IsEnabled="{Binding HasPreviousPage}" FontSize="10"
							Margin="0,0,2,0" Padding="0"/>
					<Button Content="◀" Width="42" Height="28"
							Style="{StaticResource BaseButtonStyle}"
							Command="{Binding GoToPageCommand}"
							CommandParameter="{Binding CurrentPage, Converter={x:Static local:WallListPage.PrevPageConverter}}"
							IsEnabled="{Binding HasPreviousPage}" FontSize="10"
							Margin="0,0,4,0" Padding="0"/>
					<TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#262626" Margin="4,0">
						<Run Text="{l:Loc Pagination_Page}"/>
						<Run Text="{Binding CurrentPage}" FontWeight="Bold"/>
						<Run Text="{l:Loc Pagination_Separator}"/>
						<Run Text="{Binding TotalPages}" FontWeight="Bold"/>
						<Run Text="{l:Loc Pagination_PageSuffix}"/>
					</TextBlock>
					<Button Content="▶" Width="42" Height="28"
							Style="{StaticResource BaseButtonStyle}"
							Command="{Binding GoToPageCommand}"
							CommandParameter="{Binding CurrentPage, Converter={x:Static local:WallListPage.NextPageConverter}}"
							IsEnabled="{Binding HasNextPage}" FontSize="10"
							Margin="4,0,2,0" Padding="0"/>
					<Button Content="▶▶" Width="42" Height="28"
							Style="{StaticResource BaseButtonStyle}"
							Command="{Binding GoToPageCommand}"
							CommandParameter="{Binding TotalPages}"
							IsEnabled="{Binding HasNextPage}" FontSize="10"
							Padding="0"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══════════════════════════════════════════ -->
		<!--  导入进度覆盖层                               -->
		<!-- ══════════════════════════════════════════ -->
        <Border Grid.RowSpan="5" Background="#80000000"
				Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
			<Border Background="#FFFFFF" CornerRadius="8"
					Width="400" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center"
					BorderBrush="#F0F0F0" BorderThickness="1">
				<StackPanel VerticalAlignment="Center" Margin="30">
					<TextBlock Text="{l:Loc Import_Processing}" FontSize="16" FontWeight="Bold" Foreground="#262626"
							   HorizontalAlignment="Center" Margin="0,0,0,10"/>
					<TextBlock Text="{Binding ImportProgressMessage}" FontSize="12" Foreground="#8C8C8C"
							   HorizontalAlignment="Center" Margin="0,0,0,12"
							   TextTrimming="CharacterEllipsis" MaxWidth="340"/>
					<ProgressBar Value="{Binding ImportProgressValue}"
								 Maximum="{Binding ImportProgressMax}"
								 Height="8" Margin="0,0,0,6"/>
					<TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#8C8C8C">
						<Run Text="{Binding ImportProgressValue}"/>
						<Run Text=" / "/>
						<Run Text="{Binding ImportProgressMax}"/>
					</TextBlock>
				</StackPanel>
			</Border>
		</Border>
	</Grid>
</Page>
